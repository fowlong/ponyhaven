# Firebase WEB app settings are public identifiers; never add admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Production deployments set this to true. Unconfigured local previews can play offline.
VITE_REQUIRE_AUTH=false
# Pages companion: pet care, shop and collection. Desktop always keeps all games.
VITE_COMPANION=false
